---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { focusAreas } from '../data/projects';
import { donateUrl, organisationProfileUrl } from '../config';

import heroImg from '../assets/photos/community-cleanup.jpg';
---

<Base
  title="Support a Project"
  description="Sponsor one of our four programmes: mental health awareness, water sanitation and health, climate resilience, or quality education."
  image={heroImg}
>
  <PageHero
    eyebrow="Empower progress, one project at a time"
    title="Real impact starts with you"
    lead="Whether it's raising mental health awareness, building access to safe water, providing quality education, or protecting our environment—your support turns challenges into change."
    image={heroImg}
    imageAlt="Two volunteers carrying sacks during a community clean-up on a dirt road in Bwaise"
    focus="50% 30%"
  />

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <h2>Sponsor a project today</h2>
        <p>Help communities thrive with strength and dignity.</p>
      </div>
      <div class="grid-4">
        {
          focusAreas.map((f) => (
            <article class={`project project-${f.color}`}>
              <Image src={f.illustration} alt="" width={563} height={307} />
              <div class="body">
                <h3>{f.area}</h3>
                <p class="name">{f.project}</p>
                <p>{f.summary}</p>
                <div class="actions">
                  <a class="btn btn-donate" href={donateUrl} target="_blank" rel="noopener">
                    Support this project
                  </a>
                  <a class="text-link" href={`/our-projects/#${f.id}`}>
                    Learn more<span class="visually-hidden"> about {f.area}</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <p class="profile">
        Looking to partner or fund a programme?
        <a href={organisationProfileUrl} download>Download our organisation profile</a> (PDF, 1 page).
      </p>
    </div>
  </section>
</Base>

<style>
  .project {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border-top: 5px solid var(--accent);
  }
  .project-purple {
    --accent: var(--purple-600);
  }
  .project-blue {
    --accent: var(--blue-700);
  }
  .project-green {
    --accent: var(--green-600);
  }
  .project-amber {
    --accent: var(--amber-500);
  }
  .project img {
    width: 100%;
    aspect-ratio: 563 / 307;
    object-fit: cover;
  }
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.4rem 1.5rem 1.6rem;
  }
  .body h3 {
    margin-bottom: 0.2rem;
  }
  .name {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .body p:not(.name) {
    color: var(--ink-soft);
    font-size: 0.975rem;
    flex: 1;
  }
  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }
  .profile {
    margin-top: 2.5rem;
    text-align: center;
    color: var(--ink-muted);
  }
</style>
