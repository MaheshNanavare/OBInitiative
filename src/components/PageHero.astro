---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image: ImageMetadata;
  imageAlt: string;
  /** CSS object-position for the background photo. */
  focus?: string;
}

const { eyebrow, title, lead, image, imageAlt, focus = 'center' } = Astro.props;
---

<section class="page-hero">
  <Image
    class="bg"
    src={image}
    alt={imageAlt}
    widths={[640, 1024, 1600, 2200]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    style={`object-position: ${focus}`}
  />
  <div class="shade"></div>
  <div class="container inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(340px, 52vh, 520px);
    display: flex;
    align-items: flex-end;
    color: var(--white);
    overflow: hidden;
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(45 20 71 / 0.15) 0%, rgb(45 20 71 / 0.55) 45%, rgb(30 12 50 / 0.92) 100%),
      linear-gradient(90deg, rgb(45 20 71 / 0.55), transparent 70%);
  }
  .inner {
    padding-block: clamp(3rem, 8vw, 5rem) clamp(2.5rem, 6vw, 4rem);
  }
  h1 {
    color: var(--white);
    max-width: 16ch;
    margin-bottom: 0.4em;
  }
  .eyebrow {
    color: #d7ecd2;
  }
  .lead {
    color: #f1e9f8;
    max-width: 60ch;
    margin-bottom: 0;
  }
  .inner :global(.btn-row) {
    margin-top: 1.75rem;
  }
</style>
